# Pagefreeze configuration.
#
# Copy to .env and fill in the REQUIRED values before running `docker compose up`.
# Every variable here is also read by the Node process directly when running outside
# Docker; see docs/configuration.md for the full reference.

# ---------------------------------------------------------------------- REQUIRED

# Admin password for the web UI. There is exactly one admin account.
# The server refuses to start in production with this unset or set to a known default
# (changeme, admin, password, pagefreeze, ...).
PAGEFREEZE_ADMIN_PASSWORD=

# AES-256-GCM key used to encrypt monitor headers, cookies and webhook secrets at rest.
# MUST be 32 bytes of base64. Generate with:
#   openssl rand -base64 32
# Losing or changing this key makes stored secrets unreadable. See docs/security.md.
PAGEFREEZE_SECRET_KEY=

# Password for the PostgreSQL container.
POSTGRES_PASSWORD=

# ------------------------------------------------------------------ RECOMMENDED

# Admin username (default: admin).
PAGEFREEZE_ADMIN_USERNAME=admin

# Public base URL of this instance, used to build share links and notification links.
# Set this when running behind a reverse proxy or on a hostname other than localhost.
PAGEFREEZE_BASE_URL=http://localhost:8080

# Host port the web UI and API are published on.
PAGEFREEZE_PORT=8080

# postgres container user/database (defaults are fine for a fresh install).
POSTGRES_USER=pagefreeze
POSTGRES_DB=pagefreeze

# ---------------------------------------------------------------------- CAPTURE

# How many captures may run at once. Chromium is heavy: 2 is a good default on 4 GB.
PAGEFREEZE_CAPTURE_CONCURRENCY=2

# Hard per-capture timeout in milliseconds.
PAGEFREEZE_CAPTURE_TIMEOUT_MS=60000

# Retries per capture, with exponential backoff (1s, 2s, 4s ... capped at 30s).
PAGEFREEZE_CAPTURE_RETRIES=2

# Minimum interval between scheduled runs, in minutes. Guards against accidentally
# monitoring a site every 60 seconds.
PAGEFREEZE_MIN_INTERVAL_MINUTES=15

# Block media and font subresources during capture. Faster and more stable screenshots;
# set false if you need media playback or the page's own fonts. Images are not blocked.
PAGEFREEZE_BLOCK_MEDIA=true

# ---------------------------------------------------------------------- SECURITY

# Allow capturing loopback / private / link-local / metadata addresses.
# LEAVE FALSE unless you deliberately monitor internal services (for example the demo).
ALLOW_PRIVATE_TARGETS=false

# Comma-separated host[:port] allowlist exempted from the SSRF address check, e.g.
#   PAGEFREEZE_ALLOWED_HOSTS=127.0.0.1:8091
# Use this instead of ALLOW_PRIVATE_TARGETS when only one internal host is needed.
PAGEFREEZE_ALLOWED_HOSTS=

# Set true when the instance is served over HTTPS: enables Secure cookies and HSTS.
PAGEFREEZE_SECURE_COOKIES=false

# --------------------------------------------------------------- DATA & RETENTION

# Snapshots, changes and diff images older than this are deleted by the retention job.
# The newest successful snapshot of each monitor is always kept.
PAGEFREEZE_RETENTION_DAYS=90

# ------------------------------------------------------------------ NOTIFICATIONS

# Outbound email (used by email channels). Leave SMTP_HOST empty to disable email;
# email channels will then report a clear error instead of silently failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --------------------------------------------------------------------------- MISC

# One of: all (default), api (HTTP only), worker (captures only). See docs/architecture.md.
PAGEFREEZE_MODE=all

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Development outside Docker: set DATABASE_URL to a local PostgreSQL URL.
# The Node process reads shell variables; Compose loads .env automatically.
# DATABASE_URL=postgres://pagefreeze:YOUR_PASSWORD@127.0.0.1:5432/pagefreeze
