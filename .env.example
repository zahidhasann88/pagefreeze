# Copy to .env and fill in the required values. Full reference: docs/configuration.md

# --- Required
PAGEFREEZE_ADMIN_PASSWORD=
# Generate with: openssl rand -base64 32 (keep it safe; changing it breaks stored secrets)
PAGEFREEZE_SECRET_KEY=
POSTGRES_PASSWORD=

# --- General
PAGEFREEZE_ADMIN_USERNAME=admin
PAGEFREEZE_BASE_URL=http://localhost:8080
PAGEFREEZE_PORT=8080
POSTGRES_USER=pagefreeze
POSTGRES_DB=pagefreeze

# --- Capture
PAGEFREEZE_CAPTURE_CONCURRENCY=2
PAGEFREEZE_CAPTURE_TIMEOUT_MS=60000
PAGEFREEZE_CAPTURE_RETRIES=2
PAGEFREEZE_MIN_INTERVAL_MINUTES=15
PAGEFREEZE_BLOCK_MEDIA=true

# --- Security
# Keep false unless you need to monitor internal/private addresses
ALLOW_PRIVATE_TARGETS=false
# Allow specific internal hosts only, e.g. 127.0.0.1:8091
PAGEFREEZE_ALLOWED_HOSTS=
# Set true when served over HTTPS
PAGEFREEZE_SECURE_COOKIES=false

# --- Retention
PAGEFREEZE_RETENTION_DAYS=90

# --- Email (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Misc
# all | api | worker
PAGEFREEZE_MODE=all
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# For local development outside Docker:
# DATABASE_URL=postgres://pagefreeze:YOUR_PASSWORD@127.0.0.1:5432/pagefreeze
