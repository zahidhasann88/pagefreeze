{
  "name": "@pagefreeze/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "api": "cross-env PAGEFREEZE_MODE=api tsx src/index.ts",
    "worker": "cross-env PAGEFREEZE_MODE=worker tsx src/index.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:down": "tsx src/scripts/migrate.ts down",
    "demo": "tsx src/scripts/demo.ts",
    "seed": "tsx src/scripts/seed.ts",
    "fixture": "tsx src/scripts/fixture.ts",
    "openapi": "tsx src/scripts/generateOpenApi.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "coverage": "vitest run --coverage",
    "e2e-server": "tsx src/scripts/e2eServer.ts",
    "screenshots": "tsx src/scripts/screenshots.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.0",
    "@pagefreeze/shared": "workspace:*",
    "diff": "^8.0.2",
    "fastify": "^5.4.0",
    "node-pg-migrate": "^7.9.1",
    "nodemailer": "^6.10.0",
    "pg": "^8.16.0",
    "pg-boss": "^10.1.4",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.54.0",
    "pngjs": "^7.0.0",
    "pino": "^9.7.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^20.19.9",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.0",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^7.0.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
